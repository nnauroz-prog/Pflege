{
  "name": "pflege-plattform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PflegeMatch – Vermittlungsplattform für Pfleger-Gesellschafter ohne Patienten",
  "workspaces": ["client", "server"],
  "scripts": {
    "build": "npm run build --prefix client",
    "seed": "node server/src/seed.js",
    "start": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm run dev --prefix client"
  }
}
